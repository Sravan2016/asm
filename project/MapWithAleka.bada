from: com.base.Map;

MapWithAleka->
    main{String[] args} -->
        Map m = Map.of("key1","value1","key2","value2");
        m.put("key3","value3");
        User user = User.of(1, "Name","mail1", "password", 9182592263l);
        println(user.toString());
        m.put("key4", user.toString());
        User users = User.of(0, "", "", "", 0l);
        String value = m.get("key4");
        users.toObject(value);
        println(users.getId()+" "+users.getUserName()+" "+users.getMailId()+" "+users.getPassword()+" "+users.getPhoneNumber());
        m.containsKey("key3");
        m.remove("key1");
        m.size();
        m.isEmpty();
        println("printing all m values: "+ m.toString());
        m.clear();
        println(m.toString());
